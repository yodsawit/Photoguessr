# Copy to .env for local dev against real R2 (without R2 values, the dev server uses in-memory storage
# and prints a throwaway admin code). Never commit .env.
ADMIN_CODE=
# Long random string. Must be the SAME value as KEY_PEPPER on Render (both use the same bucket).
KEY_PEPPER=
# R2 S3 endpoint: https://<account-id>.r2.cloudflarestorage.com  (or set R2_ACCOUNT_ID instead)
R2_S3_ENDPOINT=
R2_ACCOUNT_ID=
# From R2 -> Manage API tokens (Object Read & Write, bucket photoguessr).
# The token value itself (R2_API_TOKEN) is NOT needed.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photoguessr
NOMINATIM_CONTACT=
