{
  "name": "photoguessr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch --import tsx server/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "preview": "npm run build && npm start",
    "upload": "tsx scripts/upload.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:sweeper": "esbuild sweeper/worker.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist-sweeper/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@hono/node-server": "^2.1.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.9",
    "leaflet": "^1.9.4",
    "motion": "^13.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
